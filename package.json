{
  "name": "upclass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "build": "next build --webpack",
    "build:vercel": "npm run lint && npm run type-check && npm run test && if [ -n \"$DATABASE_URL\" ]; then npm run db:migrate; else echo 'Skipping db:migrate because DATABASE_URL is not set'; fi && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
